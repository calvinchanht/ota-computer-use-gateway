{
  "name": "ota-computer-use-gateway",
  "version": "0.1.22",
  "description": "Provider-neutral local computer-use gateway for OTA/web-thread agents.",
  "type": "module",
  "bin": {
    "ota-computer-use-gateway": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "style": "node scripts/check-style.mjs",
    "check": "npm run style && npm run build && npm run validate:action-schemas && npm test",
    "smoke:stdio": "npm run build && node scripts/smoke-stdio.mjs",
    "smoke:http": "npm run build && node scripts/smoke-http.mjs",
    "smoke:primitives": "npm run build && node scripts/smoke-primitives.mjs",
    "smoke:windows-computer": "npm run build && node scripts/smoke-windows-computer.mjs",
    "smoke:public": "node scripts/smoke-public.mjs",
    "smoke:provider-acceptance": "node scripts/smoke-provider-acceptance.mjs",
    "smoke:mickey-acceptance": "node scripts/smoke-provider-acceptance.mjs",
    "smoke:catalyst-acceptance": "OTA_GATEWAY_SMOKE_WORKSPACE=catalyst OTA_GATEWAY_ACCEPTANCE_SKILL=catalyst-pickup node scripts/smoke-provider-acceptance.mjs",
    "status:catalyst-connector": "node scripts/catalyst-connector-status.mjs",
    "audit:retention": "node scripts/audit-retention.mjs",
    "retention:runtime-logs": "node scripts/prune-runtime-logs.mjs",
    "retention:deployments": "node scripts/prune-deployment-backups.mjs",
    "config:sync-exposed-tools": "node scripts/sync-exposed-tools.mjs",
    "generate:action-schemas": "node scripts/generate-action-schemas.mjs",
    "validate:action-schemas": "node scripts/validate-action-schemas.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "sharp": "^0.35.3",
    "yaml": "2.9.0",
    "yazl": "^3.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "@typescript-eslint/eslint-plugin": "8.60.0",
    "@typescript-eslint/parser": "8.60.0",
    "eslint": "10.4.0",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  },
  "engines": {
    "node": ">=22"
  }
}
